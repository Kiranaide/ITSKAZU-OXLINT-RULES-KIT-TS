{
  "name": "@kiranaide/oxlint-kit",
  "version": "0.1.0",
  "description": "Profile-based Oxlint setup: generated presets, sonarjs, vendored anti-slop, Prettier and a violation baseline.",
  "keywords": [
    "oxlint",
    "lint",
    "cli",
    "sonarjs",
    "prettier"
  ],
  "license": "MIT",
  "type": "module",
  "bin": {
    "oxlint-kit": "./dist/cli.js"
  },
  "files": [
    "dist",
    "vendor",
    "templates"
  ],
  "engines": {
    "node": ">=22.18.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Kiranaide/ITSKAZU-OXLINT-RULES-KIT-TS.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "sync-anti-slop": "node scripts/sync-anti-slop.ts",
    "gen:sonar": "node scripts/gen-sonar-preset.ts",
    "check-vendor": "node scripts/sync-anti-slop.ts --check",
    "prepublishOnly": "bun run check-vendor && bun run gen:sonar && bun run build",
    "changeset": "changeset",
    "release": "changeset publish"
  },
  "dependencies": {
    "@clack/prompts": "^0.11.0",
    "citty": "^0.1.6",
    "cross-spawn": "^7.0.6",
    "picocolors": "^1.1.1"
  },
  "devDependencies": {
    "@changesets/cli": "^2.29.0",
    "@types/cross-spawn": "^6.0.6",
    "@types/node": "^22.18.0",
    "@typescript/native": "npm:typescript@^7.0.2",
    "eslint-plugin-sonarjs": "^4.2.2",
    "tsup": "^8.5.0",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vitest": "^3.2.0"
  }
}
